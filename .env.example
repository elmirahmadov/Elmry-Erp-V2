NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Local (docker compose mysql on 3307):
DATABASE_URL="mysql://elmry:elmry@127.0.0.1:3307/elmry_erp"

# Inside Docker network use:
# DATABASE_URL="mysql://elmry:elmry@mysql:3306/elmry_erp"

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
